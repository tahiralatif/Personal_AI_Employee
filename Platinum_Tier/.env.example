# Platinum Tier AI Employee - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# CLOUD CONFIGURATION
# =============================================================================
CLOUD_VM_IP=your_cloud_vm_ip
CLOUD_VM_USER=ubuntu
CLOUD_VM_SSH_KEY=~/.ssh/id_rsa

# =============================================================================
# VAULT SYNC CONFIGURATION
# =============================================================================
# Option A: Git-based sync
VAULT_SYNC_GIT_REPO=https://github.com/yourusername/your-vault-repo.git
VAULT_SYNC_GIT_BRANCH=main
VAULT_SYNC_INTERVAL=300  # seconds

# Option B: Syncthing
VAULT_SYNC_SYNCTHING_FOLDER=/path/to/synced/vault
VAULT_SYNC_SYNCTHING_DEVICE_ID=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# NEVER sync these files!
ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=

# =============================================================================
# CLOUD AGENT CONFIGURATION (Draft-Only)
# =============================================================================
CLOUD_GEMINI_API_KEY=
CLOUD_MODE=draft_only
CLOUD_APPROVAL_REQUIRED=true

# =============================================================================
# LOCAL AGENT CONFIGURATION (Approval + Execution)
# =============================================================================
LOCAL_GEMINI_API_KEY=
LOCAL_MODE=approval_and_execution
LOCAL_APPROVAL_TIMEOUT=3600  # 1 hour

# =============================================================================
# ODOO CLOUD CONFIGURATION
# =============================================================================
CLOUD_ODOO_URL=https://your-cloud-odoo.com
CLOUD_ODOO_DB=odoo_db
CLOUD_ODOO_USERNAME=admin
CLOUD_ODOO_PASSWORD=
CLOUD_ODOO_API_KEY=

# =============================================================================
# A2A COMMUNICATION CONFIGURATION
# =============================================================================
A2A_ENABLED=false
A2A_MESSAGE_QUEUE=/path/to/message_queue
A2A_POLL_INTERVAL=60  # seconds

# =============================================================================
# HEALTH MONITORING
# =============================================================================
HEALTH_CHECK_INTERVAL=300  # seconds
HEALTH_CHECK_URL=http://localhost:8080/health
AUTO_RESTART_ON_FAILURE=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/platinum_tier.log
VERBOSE_LOGGING=false
