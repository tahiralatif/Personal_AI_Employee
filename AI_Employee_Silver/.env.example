# AI Employee Silver Tier - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git - it's excluded by .gitignore

# =============================================================================
# LLM CONFIGURATION (Gemini via OpenAI SDK)
# =============================================================================
# Get FREE Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# Alternative: Use OpenAI instead of Gemini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo

# =============================================================================
# VAULT CONFIGURATION
# =============================================================================
# Path to your AI Employee vault (use absolute path)
VAULT_PATH=D:\Documents\Tahira's-work\New folder\projects\New folder\Personal_AI_Employee\AI_Employee_Bronze\AI_Employee_Vault

# =============================================================================
# GMAIL API CONFIGURATION
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080
GMAIL_ACCOUNT_EMAIL=your-email@gmail.com

# =============================================================================
# WHATSAPP TWILIO CONFIGURATION
# =============================================================================
# Get FREE Twilio sandbox: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Your phone number for notifications (with country code)
YOUR_PHONE_NUMBER=+923151082542

# =============================================================================
# LINKEDIN API CONFIGURATION
# =============================================================================
# Get credentials from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_ACCESS_TOKEN=your-access-token
LINKEDIN_ORGANIZATION_ID=your-organization-id

# LinkedIn Browser Automation (Playwright)
# For browser-based posting without API access
LINKEDIN_EMAIL=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password

# =============================================================================
# APPROVAL WORKFLOW CONFIGURATION
# =============================================================================
# Approval timeout in hours (24 hours default)
APPROVAL_TIMEOUT_HOURS=24

# Auto-approve low priority tasks (true/false)
AUTO_APPROVE_LOW_PRIORITY=false

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Monitoring interval in seconds
MONITOR_INTERVAL=30

# Maximum messages to fetch at once
MAX_MESSAGES=10

# Task keywords for detection (comma-separated)
TASK_KEYWORDS=please,need,urgent,task,action,required,must,should,remind,todo

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Maximum retry attempts for failed API calls
MAX_RETRY_ATTEMPTS=3

# Initial retry delay in seconds
RETRY_INITIAL_DELAY=1

# Maximum retry delay in seconds
RETRY_MAX_DELAY=60

# Enable exponential backoff (true/false)
RETRY_EXPONENTIAL_BACKOFF=true
