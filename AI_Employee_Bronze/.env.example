# Environment variables for Bronze Tier AI Employee
# Copy this file to .env and fill in your values
# NEVER commit .env to Git - it's excluded by .gitignore

# =============================================================================
# VAULT CONFIGURATION
# =============================================================================
# Path to your AI Employee vault (use absolute path)

# Windows example:
# VAULT_PATH=C:\Users\YourUsername\AI_Employee_Vault

# Linux/WSL example:
# VAULT_PATH=/home/username/AI_Employee_Vault

# macOS example:
# VAULT_PATH=/Users/username/AI_Employee_Vault

# Choose ONE based on your platform (uncomment and edit):
VAULT_PATH=~/AI_Employee_Vault

# Folder to watch for new files (must be inside vault)
# Windows example:
# WATCHED_FOLDER=C:\Users\YourUsername\AI_Employee_Vault\Inbox

# Linux/WSL/macOS example:
WATCHED_FOLDER=~/AI_Employee_Vault/Inbox

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
